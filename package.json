{
  "name": "brycedecora",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "bean": "node scripts/generate-bean.mjs",
    "og": "astro build && node scripts/generate-og.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "serve": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "test": "pnpm run check && pnpm run build && pnpm run test:seo",
    "test:seo": "vitest run",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "node-html-parser": "^9.0.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.1"
  }
}
