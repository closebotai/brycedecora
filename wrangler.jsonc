{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brycedecora",
  "compatibility_date": "2026-09-29",

  // Fully static Astro build: Cloudflare serves ./dist directly and no Worker
  // is invoked per request. The @astrojs/cloudflare adapter is intentionally
  // NOT installed -- it is only needed for on-demand rendering. If SSR is ever
  // added, install the adapter and add a "main" entry here.
  "assets": {
    "directory": "./dist",

    // URL POLICY -- must stay in sync with `trailingSlash: 'always'` and
    // `build.format: 'directory'` in astro.config.ts.
    //
    // "force-trailing-slash" is chosen over Cloudflare's "auto-trailing-slash"
    // default on purpose: `auto` infers the policy from file layout, `force`
    // states it. /about is redirected to /about/ rather than being served at
    // both URLs. tests/seo/urls.spec.ts asserts every canonical agrees.
    "html_handling": "force-trailing-slash",

    // Serve dist/404.html with a real 404 status for unmatched requests.
    // Without this, unmatched paths return 200 and become soft-404s.
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
